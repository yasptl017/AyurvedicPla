<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request is already for the public folder, do not rewrite again.
    RewriteCond %{REQUEST_URI} !^/public/

    # If the requested filename exists in the repo root, serve it directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send all other requests into the Laravel public folder.
    RewriteRule ^ public/$1 [L]
</IfModule>
